			<value id="dp" value="0x0f"/>
			<value id="mdp" value="0x10"/>
			<value id="hdmi1" value="0x11"/>
			<value id="hdmi2" value="0x12"/>
		</control>

		<control id="dellpaper" address="0xf0">
			<value id="set" value="0x08"/>
		</control>

		<control id="magicbright" address="0xdc">
