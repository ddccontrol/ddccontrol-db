		</control>

		<control id="power" type="list" address="0xe1">
			<value id="off" value="1"/>
			<value id="on"  value="0"/>
		</control>

		<control id="dpms" address="0xd6">
			<value id="on" value="1"/>
			<value id="standby" value="4"/>
			<value id="off" value="5"/>
