		<!-- Control 0x10: +/26/100 C [Brightness] -->
		<!-- Control 0x12: +/100/125 C [Contrast] -->
		<!-- Control 0x16: +/97/100 C [Red maximum level] -->
		<!-- Control 0x18: +/94/100 C [Green maximum level] -->
		<!-- Control 0x1a: +/90/100 C [Blue maximum level] -->

