<?xml version="1.0"?>
<!-- https://github.com/ddccontrol/ddccontrol-db/issues/432 -->
<!-- Conservative initial profile; additional controls need hardware verification. -->
<monitor name="LG UltraGear 34GL750-B" init="standard">
	<!-- Restrict inherited VESA controls to the explicitly named adjustment controls. -->
	<caps add="(type(lcd)vcp(10 12 16 18 1A 62))" remove="(vcp(00 02 04 05 06 08 0E 1C 1E 20 22 24 26 28 30 32 38 3A 3C 3E 40 42 44 46 48 4A 4C 54 56 58 60 6C 6E 70 AA B0 CC D6 E1))"/>
	<!--
		Raw capabilities from both issue reports, retained for investigation only:
		(prot(monitor)type(lcd)model(GL750)cmds(01 02 03 0C E3 F3)vcp(02 04 05 08 10 12 14(05 08 0B ) 16 18 1A 52 60(11 12 0F 10 ) AC AE B2 B6 C0 C6 C8 C9 D6(01 04) DF 62 8D F4 F5(01 02 03 04) F6(00 01 02) 4D 4E 4F 15(01 06 11 13 14 15 18 19 20 22 23 24 28 29 32 48) F7(00 01 02 03) F8(00 01) F9 EF FA(00 01) FD(00 01) FE(00 01 02) FF)mccs_ver(2.1)mswhql(1))
		The reports hide engineering/vendor-specific controls 0xe0-0xff.
		Those advertised addresses have no scan readings or confirmed meanings.
	-->
	<controls>
		<!-- Control 0x10: +/6/100 C [Brightness] -->
		<control id="brightness" address="0x10"/>
		<!-- Control 0x12: +/55/100 C [Contrast] -->
		<control id="contrast" address="0x12"/>
		<!-- Control 0x16: +/50/100 C [Red maximum level] -->
		<control id="red" address="0x16"/>
		<!-- Control 0x18: +/50/100 C [Green maximum level] -->
		<control id="green" address="0x18"/>
		<!-- Control 0x1a: +/48/100 C [Blue maximum level] -->
		<control id="blue" address="0x1A"/>
		<!-- Control 0x62: +/0/100 C [Audio Speaker Volume Adjust] -->
		<control id="audiospeakervolume" address="0x62"/>

		<!-- Status control; no write mapping is exposed. -->
		<!-- Control 0x02: +/2/2 C [New Control Value - Some values changed] -->
		<!-- Destructive controls intentionally kept disabled. -->
		<!-- Control 0x04: +/0/255 C [Restore Factory Defaults] -->
		<!-- Control 0x05: +/0/1 C [Restore Brightness and Contrast] -->
		<!-- Control 0x08: +/0/255 C [Restore Factory Default Color] -->

		<!-- Control 0x60: +/15/18 C [Input Source Select (Main) - DP-1] -->
		<!-- Control 0xd6: +/1/5 C [DPMS Control - On] -->
		<!--
			Only the current input (0x0f = DP-1) and power state (0x01 = On)
			are named in the reports. Switching inputs or power states is untested.
			Unverified candidate mappings from VESA and the advertised values
			remain commented out until confirmed on this monitor:

			<control id="inputsource" type="list" address="0x60">
				<value id="dp1" value="0x0f"/>
				<value id="dp2" value="0x10"/>
				<value id="hdmi1" value="0x11"/>
				<value id="hdmi2" value="0x12"/>
			</control>
			<control id="dpms" type="list" address="0xd6">
				<value id="on" value="0x01"/>
				<value id="off" value="0x04"/>
			</control>
		-->

		<!-- Unknown scan controls, preserved verbatim for future investigation. -->
		<!-- Some current/max values are inconsistent; no meanings are inferred. -->
		<!-- Control 0x06: +/0/255   [???] -->
