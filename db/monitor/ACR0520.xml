		<!-- Control 0x18: +/100/100 C [Green maximum level] -->
		<!-- Control 0x1a: +/90/100 C [Blue maximum level] -->
		<!-- Control 0x62: +/70/100 C [Audio Speaker Volume Adjust] -->

		<!--
			Named controls kept disabled until their write behavior and values
